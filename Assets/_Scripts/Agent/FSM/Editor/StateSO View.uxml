<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement name="Container">
        <ui:TextField label="State Name" placeholder-text="상태 이름을 입력하세요" name="StateNameField" binding-path="stateName"/>
        <ui:DropdownField label="Class Name" name="ClassNameDropdown" binding-path="className"/>
        <ui:IntegerField label="Asset Index" value="0" name="AssetIndexField" binding-path="assetIndex"/>
        <ui:IntegerField label="Layer Index" value="0" name="AssetIndexField" binding-path="layerIndex"/>
        <uie:ObjectField label="Anim State" name="StateParamField" type="DevLib.AnimatorSystem.HashDataSO, AnimatorSystem_assembly" binding-path="stateParam"/>
    </ui:VisualElement>
</ui:UXML>